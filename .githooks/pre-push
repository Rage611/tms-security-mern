#!/bin/sh

# Pre-push hook: Automatically run Playwright tests before pushing to main

echo ""
echo "========================================================"
echo "🛡️  TMS SECURITY: PRE-PUSH AUTOMATED TEST GUARD"
echo "========================================================"

is_main_push=0
while read -r local_ref local_sha remote_ref remote_sha
do
    if [ "$remote_ref" = "refs/heads/main" ]; then
        is_main_push=1
    fi
done

if [ "$is_main_push" -eq 1 ]; then
    echo "Target branch is 'main'. Running 78 Playwright tests..."
    echo ""
    cd frontend || exit 1
    npm test
    test_exit_code=$?
    if [ $test_exit_code -ne 0 ]; then
        echo ""
        echo "❌ TESTS FAILED! Aborting git push to main."
        echo "Production deployment blocked until all tests pass."
        echo "========================================================"
        exit 1
    fi
    echo ""
    echo "✅ ALL TESTS PASSED! Proceeding with push to main."
    echo "========================================================"
else
    echo "Target is not 'main'. Fast push allowed."
fi

exit 0
